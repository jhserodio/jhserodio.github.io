---
import type { App } from '../lib/content';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const ui = t(lang);
---
{app.data.status !== 'active' ? (
  <p class="muted">{ui.planned} — {lang === 'pt' ? 'a lógica do app será implementada em outra fase.' : 'the app logic will be implemented in a later phase.'}</p>
) : (
  <form class="app-runner" data-type={app.data.type} data-module={app.data.wasmModule} data-api={app.data.apiUrl}>
    <label class="form-field">
      <span>{ui.payload}</span>
      <textarea name="payload" spellcheck="false">{'{}'}</textarea>
    </label>
    <button type="submit">{ui.run}</button>
    <h2>{ui.response}</h2>
    <pre class="result" aria-live="polite"></pre>
  </form>
)}
<!-- Executed only on pages with an active app. Static planned entries do not instantiate a runner. -->
<script is:inline src="/app-runner.js"></script>
