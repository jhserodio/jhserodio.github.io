---
import type { App } from '../lib/content';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';
interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const ui = t(lang);
---
{app.data.status !== 'active' ? (
  <p class="muted">{ui.planned} — {lang === 'pt' ? 'a lógica do app será implementada em outra fase.' : 'the app logic will be implemented in a later phase.'}</p>
) : (
  <form class="app-runner" data-type={app.data.type} data-module={app.data.wasmModule} data-api={app.data.apiUrl}>
    <label class="form-field">
      <span>{ui.payload}</span>
      <textarea name="payload" spellcheck="false">{'{}'}</textarea>
    </label>
    <button type="submit">{ui.run}</button>
    <h2>{ui.response}</h2>
    <pre class="result" aria-live="polite"></pre>
  </form>
)}
<script>
  import { wasmModules } from '../wasm/registry';

  document.querySelectorAll('form.app-runner').forEach((element) => {
    if (!(element instanceof HTMLFormElement)) return;
    const form = element;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const output = form.querySelector('pre.result');
      const button = form.querySelector('button');
      const textarea = form.querySelector('textarea');
      if (!output || !button || !textarea) return;

      button.disabled = true;
      output.textContent = '...';
      try {
        const payload = JSON.parse(textarea.value);
        if (form.dataset.type === 'api-backed') {
          const url = form.dataset.api;
          if (!url) throw new Error('API not configured');
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          output.textContent = await response.text();
        } else if (form.dataset.type === 'wasm-interactive') {
          const moduleName = form.dataset.module;
          if (moduleName !== 'cvrp-solver') throw new Error('Unknown WASM module');
          const module = await wasmModules['cvrp-solver']();
          await module.default();
          if (!module.solve) throw new Error('This module does not export solve(input: string) yet');
          output.textContent = module.solve(JSON.stringify(payload));
        } else {
          throw new Error('Unsupported application type');
        }
      } catch (error) {
        output.textContent = String(error);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
