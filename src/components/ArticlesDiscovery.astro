---
import ArticleCard from './ArticleCard.astro';
import type { Article } from '../lib/content';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; articles: Article[] }
const { lang, articles } = Astro.props;
const words = lang === 'pt' ? {
  heading: 'Filtrar por tags',
  hint: 'Selecione uma ou mais tags para refinar os artigos.',
  clear: 'Limpar filtros',
  shown: 'Artigos exibidos',
  empty: 'Nenhum artigo corresponde às tags selecionadas. Limpe os filtros ou escolha outras tags.',
} : {
  heading: 'Filter by tags',
  hint: 'Select one or more tags to narrow the articles.',
  clear: 'Clear filters',
  shown: 'Articles shown',
  empty: 'No articles match the selected tags. Clear the filters or choose other tags.',
};
const tagCounts = new Map<string, number>();
for (const article of articles) {
  for (const tag of new Set(article.data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const facets = [...tagCounts.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([tag, count]) => ({ tag, count }));
---

<div class="discovery-layout">
  {facets.length > 0 && (
    <aside class="discovery-sidebar" data-article-filters aria-label={words.heading}>
      <button
        type="button"
        class="sidebar-toggle"
        data-sidebar-toggle
        aria-controls="sidebar-filter-content"
        aria-expanded="false"
      >
        <span>{words.heading}</span>
        <span class="active-filter-count" data-active-filter-count hidden>0</span>
        <span class="sidebar-chevron" aria-hidden="true"></span>
      </button>

      <section id="sidebar-filter-content" class="filter-panel" aria-labelledby="article-tag-filter-heading">
        <div class="filter-header">
          <h2 id="article-tag-filter-heading">{words.heading}</h2>
          <button class="clear-filter" type="button" data-clear-filters disabled>{words.clear}</button>
        </div>
        <p class="filter-hint">{words.hint}</p>
        <div class="filter-options" role="group" aria-label={words.heading}>
          {facets.map(({tag, count}) => (
            <button
              class="filter-chip"
              type="button"
              data-filter-tag={tag}
              aria-pressed="false"
              aria-controls="filtered-articles"
            >
              <span class="filter-label">{tag}</span>
              <span class="filter-count" aria-hidden="true">{count}</span>
            </button>
          ))}
        </div>
        <p class="filter-status" data-filter-status data-label={words.shown} role="status" aria-live="polite">
          {words.shown}: {articles.length} / {articles.length}
        </p>
      </section>
    </aside>
  )}
  <div class="discovery-content">
    <div id="filtered-articles" class="card-grid filter-results">
      {articles.map(article => (
        <div class="filter-item" data-article-item data-tags={JSON.stringify(article.data.tags)}>
          <ArticleCard article={article} lang={lang} />
        </div>
      ))}
    </div>
    <p class="filter-empty" data-filter-empty hidden>{words.empty}</p>
  </div>
</div>

<script>
  // The list remains fully visible without JavaScript.
  const root = document.querySelector<HTMLElement>('[data-article-filters]');
  if (root) {
    // On narrow viewports the sidebar becomes a disclosure controlled by a
    // real button. Without JavaScript the tag panel remains visible.
    const mobileToggle = root.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
    const activeCount = root.querySelector<HTMLElement>('[data-active-filter-count]');
    if (mobileToggle) {
      root.dataset.enhanced = 'true';
      mobileToggle.addEventListener('click', () => {
        const expanded = mobileToggle.getAttribute('aria-expanded') !== 'true';
        mobileToggle.setAttribute('aria-expanded', String(expanded));
        root.dataset.expanded = String(expanded);
      });
    }
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
    const clear = root.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const allowed = new Set(buttons.map(button => button.dataset.filterTag).filter((tag): tag is string => !!tag));
    const items = [...document.querySelectorAll<HTMLElement>('[data-article-item]')].map(node => {
      const tags: string[] = JSON.parse(node.dataset.tags ?? '[]');
      return { node, tags: new Set(tags) };
    });
    const fromUrl = () => {
      const params = new URL(window.location.href).searchParams;
      return new Set(params.getAll('tag').filter(tag => allowed.has(tag)));
    };
    let selected = fromUrl();

    function render() {
      let count = 0;
      for (const {node, tags} of items) {
        const matches = [...selected].every(tag => tags.has(tag));
        node.hidden = !matches;
        if (matches) count++;
      }
      for (const button of buttons) button.setAttribute('aria-pressed', String(selected.has(button.dataset.filterTag ?? '')));
      if (clear) clear.disabled = selected.size === 0;
      if (activeCount) {
        activeCount.textContent = String(selected.size);
        activeCount.hidden = selected.size === 0;
      }
      if (status) status.textContent = `${status.dataset.label ?? ''}: ${count} / ${items.length}`;
      if (empty) empty.hidden = count !== 0;
    }

    function save() {
      const url = new URL(window.location.href);
      url.searchParams.delete('tag');
      for (const tag of [...selected].sort()) url.searchParams.append('tag', tag);
      window.history.pushState(null, '', url);
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const tag = button.dataset.filterTag;
        if (!tag) return;
        if (selected.has(tag)) selected.delete(tag);
        else selected.add(tag);
        render();
        save();
      });
    }
    clear?.addEventListener('click', () => {
      selected.clear();
      render();
      save();
    });
    window.addEventListener('popstate', () => {
      selected = fromUrl();
      render();
    });
    render();
  }
</script>


<style>
  .discovery-layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 1fr);
    grid-template-areas: "articles filters";
    align-items: start;
    gap: clamp(.75rem, 1.5vw, 1.4rem);
    margin-top: 1.25rem;
  }
  .discovery-content { min-width: 0; grid-area: articles; }
  .discovery-sidebar {
    grid-area: filters;
    min-width: 0;
    position: sticky;
    top: 1rem;
  }
  .filter-panel {
    border: 1px solid var(--line-soft);
    background: rgba(16, 21, 29, .4);
    border-radius: .7rem;
    padding: .85rem .7rem;
  }
  .filter-header { display: flex; flex-direction: column; gap: .45rem; margin-bottom: .55rem; }
  .filter-header h2 {
    margin: 0;
    color: var(--accent-soft);
    font-size: .99rem;
    line-height: 1.3;
  }
  .filter-hint { margin: 0 0 .8rem; color: var(--muted); font-size: .73rem; line-height: 1.4; }
  .clear-filter {
    align-self: flex-start;
    padding: .25rem .45rem;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-size: .76rem;
    text-decoration: underline;
    text-underline-offset: .2em;
  }
  .clear-filter:disabled { opacity: .4; text-decoration: none; }
  .filter-options {
    display: flex;
    flex-direction: column;
    gap: .18rem;
    max-height: min(58vh, 27rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .filter-chip {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .35rem;
    width: 100%;
    min-width: 0;
    padding: .34rem .42rem;
    line-height: 1.35;
    text-align: left;
    font-size: .78rem;
    border: 1px solid transparent;
    border-radius: .4rem;
    background: transparent;
    color: var(--muted);
    transition: background-color .15s, border-color .15s, color .15s;
  }
  .filter-chip:hover {
    color: var(--text);
    background: rgba(67, 89, 117, .23);
    border-color: var(--line-soft);
  }
  .filter-chip[aria-pressed="true"] {
    background: rgba(143, 201, 255, .16);
    border-color: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }
  .filter-label { min-width: 0; overflow-wrap: anywhere; }
  .filter-count {
    flex: none;
    color: inherit;
    font-size: .72rem;
    opacity: .7;
  }
  .filter-status {
    margin: .8rem 0 0;
    padding-top: .6rem;
    border-top: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: .74rem;
  }
  .sidebar-toggle { display: none; }
  .filter-results { margin: 0; }
  .filter-item { min-width: 0; }
  .filter-item :global(.card) { height: 100%; }
  .filter-item[hidden], .filter-empty[hidden], .active-filter-count[hidden] { display: none !important; }
  .filter-empty {
    border: 1px dashed var(--line);
    border-radius: .5rem;
    padding: 1rem;
    color: var(--muted);
  }
  @media (max-width: 55rem) {
    .discovery-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "filters" "articles";
      gap: .9rem;
    }
    .discovery-sidebar { position: static; }
    .discovery-sidebar[data-enhanced="true"] .sidebar-toggle {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .6rem;
      width: 100%;
      padding: .75rem .95rem;
      border: 1px solid var(--line);
      border-radius: .6rem;
      background: rgba(16, 21, 29, .46);
      color: var(--accent);
      text-align: left;
      font-size: .9rem;
      font-weight: 700;
    }
    .active-filter-count {
      margin-left: auto;
      min-width: 1.45rem;
      border-radius: 100px;
      background: var(--accent);
      color: var(--panel);
      font-size: .75rem;
      text-align: center;
    }
    .sidebar-chevron {
      flex: none;
      width: .55rem;
      height: .55rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
      transition: transform .15s;
    }
    .discovery-sidebar[data-expanded="true"] .sidebar-chevron { transform: rotate(225deg); }
    .discovery-sidebar[data-enhanced="true"]:not([data-expanded="true"]) .filter-panel { display: none; }
    .filter-panel { margin-top: .45rem; padding: .95rem; }
    .filter-header { flex-direction: row; align-items: baseline; justify-content: space-between; flex-wrap: wrap; }
    .filter-hint { font-size: .8rem; }
    .filter-options { max-height: min(46vh, 18rem); }
    .filter-chip { font-size: .84rem; padding: .48rem .6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .filter-chip, .sidebar-chevron { transition: none; }
  }
  @media print {
    .discovery-layout { display: block; }
    .discovery-sidebar { display: none; }
    .filter-item[hidden] { display: block !important; }
  }
</style>
