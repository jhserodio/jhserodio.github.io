---
import type { Lang } from '../i18n/ui';
import '../styles/cvrp.css';
interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = lang === 'pt' ? {
  title: 'Simulador CVRP · Rust + WebAssembly',
  intro: 'Altere os parâmetros, gere dados fictícios reproduzíveis ou edite a matriz JSON. O solver exato é executado no seu navegador.',
  params: 'Parâmetros da instância', clients: 'Clientes (2–12)',
  capacity: 'Capacidade por veículo (Q)', fleet: 'Máximo de veículos (K)',
  distance: 'Distância máxima por rota (L)', seed: 'Semente aleatória',
  generate: 'Gerar instância fictícia', run: 'Resolver com Rust/WASM',
  cancel: 'Cancelar execução', json: 'Instância JSON editável',
  hint: 'Alterar os parâmetros regenera o JSON. Depois você pode editar demandas ou distâncias manualmente. O depósito tem índice zero.',
  graph: 'Grafo da solução', result: 'Resultado da otimização',
  waiting: 'Execute o solver para visualizar as rotas.', source: 'Ver código Rust',
  back: 'Voltar aos apps', caution: 'A busca é exata e exponencial; instâncias maiores podem levar mais tempo.',
} : {
  title: 'CVRP Simulator · Rust + WebAssembly',
  intro: 'Edit parameters, generate reproducible synthetic data or change the JSON matrix. The exact solver runs in your browser.',
  params: 'Instance parameters', clients: 'Customers (2–12)',
  capacity: 'Vehicle capacity (Q)', fleet: 'Maximum vehicles (K)',
  distance: 'Maximum route distance (L)', seed: 'Random seed',
  generate: 'Generate sample instance', run: 'Solve with Rust/WASM',
  cancel: 'Cancel computation', json: 'Editable JSON instance',
  hint: 'Changing a parameter regenerates the JSON. You can then edit demands or distances by hand. The depot has index zero.',
  graph: 'Solution graph', result: 'Optimization results',
  waiting: 'Run the solver to display routes.', source: 'View Rust source',
  back: 'Back to Apps', caution: 'Exact search scales exponentially. Larger instances may take longer.',
};
---
<section class="cvrp-simulator" data-cvrp-root data-lang={lang}>
  <a class="cvrp-back" href="https://serodio.dev/en/apps/">{copy.back}</a>
  <div class="cvrp-intro"><h2>{copy.title}</h2><p>{copy.intro}</p></div>
  <form data-cvrp-form class="cvrp-form">
    <section class="cvrp-panel">
      <h3>{copy.params}</h3>
      <div class="cvrp-controls">
        <label>{copy.clients}<input data-cvrp-n type="number" min="2" max="12" step="1" value="6" required /></label>
        <label>{copy.capacity}<input data-cvrp-q type="number" min="1" max="100000" step="1" value="7" required /></label>
        <label>{copy.fleet}<input data-cvrp-k type="number" min="1" max="12" step="1" value="3" required /></label>
        <label>{copy.distance}<input data-cvrp-l type="number" min="1" max="100000" step="1" value="18" required /></label>
        <label>{copy.seed}<input data-cvrp-seed type="number" min="0" max="2147483647" step="1" value="7" required /></label>
      </div>
      <div class="cvrp-actions">
        <button type="button" data-cvrp-generate>{copy.generate}</button>
        <button type="submit" class="cvrp-primary" data-cvrp-run>{copy.run}</button>
        <button type="button" data-cvrp-cancel disabled>{copy.cancel}</button>
      </div>
      <p class="cvrp-small">{copy.caution}</p>
    </section>
    <section class="cvrp-panel">
      <label class="cvrp-json-label" for={'cvrp-json-' + lang}>{copy.json}</label>
      <p class="cvrp-small">{copy.hint}</p>
      <textarea data-cvrp-json id={'cvrp-json-' + lang} rows="17" spellcheck="false" autocomplete="off" required></textarea>
    </section>
  </form>
  <section class="cvrp-panel">
    <h3>{copy.graph}</h3>
    <div class="cvrp-graph-wrap"><svg data-cvrp-graph viewBox="0 0 900 570" role="img" aria-label={copy.graph}></svg></div>
  </section>
  <section class="cvrp-panel">
    <h3>{copy.result}</h3>
    <p role="status" aria-live="polite" data-cvrp-status>{copy.waiting}</p>
    <div data-cvrp-results></div>
    <p><a target="_blank" rel="noopener noreferrer" href="https://github.com/jhserodio/logistic_problem_with_max_capacity">{copy.source}</a></p>
  </section>
</section>
<script is:inline type="module" src="/cvrp-simulator.js"></script>
