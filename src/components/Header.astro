---
import { localePath, t, alternateLang } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; switchUrl: string }
const { lang, switchUrl } = Astro.props;
const u = t(lang);
const nextLang = alternateLang(lang);
const links = [
  { label: u.nav.home, href: localePath(lang) },
  { label: u.nav.resume, href: localePath(lang, 'resume') },
  { label: u.nav.articles, href: localePath(lang, 'articles') },
  { label: u.nav.apps, href: localePath(lang, 'apps') },
  { label: u.nav.coverLetter, href: localePath(lang, 'cover-letter') },
];
const normalize = (value: string) => value.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="site-banner" aria-hidden="true"></div>
  <div class="site-identity">
    <a class="profile-photo" href={localePath(lang)} aria-label={u.nav.home}>
      <img src="/profile-portrait.webp" alt={lang === 'pt' ? 'Retrato de João Henrique Serodio segurando uma cuia de chimarrão' : 'Portrait of João Henrique Serodio holding a mate gourd'} width="720" height="720" decoding="async" fetchpriority="high" />
    </a>
    <div class="identity-meta">
      <a class="brand" href={localePath(lang)}>João Henrique Serodio</a>
      <p class="identity-role">{lang === 'pt' ? 'Engenharia de Software · Matemática' : 'Software Engineering · Mathematics'}</p>
    </div>
  </div>
  <div class="container header-inner">
    <div class="header-right">
      <nav aria-label={lang === 'pt' ? 'Navegação principal' : 'Main navigation'}>
        <ul class="nav-list">
          {links.map(({ label, href }) => (
            <li><a href={href} aria-current={normalize(Astro.url.pathname) === normalize(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="lang-switch" href={switchUrl}
        lang={nextLang === 'pt' ? 'pt-BR' : 'en-US'}
        hreflang={nextLang === 'pt' ? 'pt-BR' : 'en-US'}
        aria-label={lang === 'pt' ? 'Switch language to English (US)' : 'Mudar idioma para português (Brasil)'}
        data-set-language={nextLang}
      >{nextLang === 'pt' ? 'PT-BR' : 'EN-US'}</a>
    </div>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-set-language]').forEach((link) => {
    link.addEventListener('click', () => {
      const next = link.dataset.setLanguage;
      if (next !== 'pt' && next !== 'en') return;
      try { localStorage.setItem('jhserodio:locale', next); } catch { /* link remains functional */ }
    });
  });
</script>
