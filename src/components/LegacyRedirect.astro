---
interface Props { suffix: 'resume' | 'cover-letter' }
const { suffix } = Astro.props;
---
<!doctype html>
<html lang="pt-BR" data-legacy-suffix={suffix}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, follow" />
    <title>Redirecting / Redirecionando</title>
    <script is:inline>
      (() => {
        const suffix = document.documentElement.dataset.legacySuffix;
        let saved;
        try { saved = localStorage.getItem('jhserodio:locale'); } catch { /* bloqueado */ }
        let detected = 'pt';
        for (const value of navigator.languages || [navigator.language]) {
          const primary = String(value || '').toLowerCase().split('-')[0];
          if (primary === 'en' || primary === 'pt') { detected = primary; break; }
        }
        const lang = saved === 'pt' || saved === 'en' ? saved : detected;
        const url = new URL(`/${lang}/${suffix}/`, location.origin);
        url.search = location.search;
        url.hash = location.hash;
        window.location.replace(url.toString());
      })();
    </script>
  </head>
  <body><p><a href={`/pt/${suffix}/`}>Continuar / Continue</a></p></body>
</html>
