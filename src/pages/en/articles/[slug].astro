---
import type { GetStaticPaths } from 'astro';
import { articlePathsFor, type Article } from '../../../lib/content';
import Page from '../../../templates/ArticleDetailPage.astro';

interface Props { entry: Article }
export const getStaticPaths = (async () => articlePathsFor('en')) satisfies GetStaticPaths;
---
<Page lang="en" entry={Astro.props.entry} />
