---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, getApps, type App } from '../lib/content';
import { alternateLang, localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; entry: App }
const { lang, entry } = Astro.props;
const u = t(lang);
const other = alternateLang(lang);
const counterpart = (await getApps(other)).find(app => entrySlug(app.id) === entrySlug(entry.id));
const switchUrl = counterpart ? localePath(other, `apps/${entrySlug(counterpart.id)}`) : localePath(other, 'apps');
const alternates = counterpart ? {
  [lang]: localePath(lang, `apps/${entrySlug(entry.id)}`),
  [other]: switchUrl,
} : { [lang]: localePath(lang, `apps/${entrySlug(entry.id)}`) };
const planned = entry.data.status === 'planned';
const external = entry.data.status === 'active' && entry.data.type === 'external-link';
const executable = entry.data.status === 'active' && entry.data.type !== 'external-link';
---
<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} switchUrl={switchUrl} alternates={alternates}>
  <p><a href={localePath(lang, 'apps')}>← {u.back}</a></p>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <ul class="tags">
      <li>{entry.data.type}</li>
      <li>{entry.data.pricing}</li>
      <li>{planned ? (lang === 'pt' ? 'Planejado' : 'Planned') : (lang === 'pt' ? 'Ativo' : 'Active')}</li>
      {entry.data.tags.map(tag => <li>{tag}</li>)}
    </ul>
    {planned && <p class="muted">{lang === 'pt' ? 'Este experimento ainda está em planejamento.' : 'This experiment is planned and not executable yet.'}</p>}
    {external && <p><a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">{lang === 'pt' ? 'Abrir projeto externo' : 'Open external project'}</a></p>}
    {executable && <form class="app-runner" data-type={entry.data.type} data-module={entry.data.wasmModule} data-api={entry.data.apiUrl}>
      <label class="form-field">
        <span>{u.payload}</span>
        <textarea name="payload" spellcheck="false">{'{}'}</textarea>
      </label>
      <button type="submit">{u.run}</button>
      <h2>{u.response}</h2>
      <pre class="result" aria-live="polite"></pre>
    </form>}
  </article>
  <script is:inline src="/app-runner.js"></script>
</BaseLayout>
