---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppRunner from '../components/AppRunner.astro';
import { entrySlug, getApps, type App } from '../lib/content';
import { alternateLang, localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; entry: App }
const { lang, entry } = Astro.props;
const u = t(lang);
const other = alternateLang(lang);
const counterpart = (await getApps(other)).find(app => entrySlug(app.id) === entrySlug(entry.id));
const switchUrl = counterpart ? localePath(other, `apps/${entrySlug(counterpart.id)}`) : localePath(other, 'apps');
const alternates = counterpart ? {
  [lang]: localePath(lang, `apps/${entrySlug(entry.id)}`),
  [other]: switchUrl,
} : { [lang]: localePath(lang, `apps/${entrySlug(entry.id)}`) };
---
<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} switchUrl={switchUrl} alternates={alternates}>
  <p><a href={localePath(lang, 'apps')}>← {u.back}</a></p>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <ul class="tags">
      <li>{entry.data.type}</li>
      <li>{entry.data.pricing}</li>
      <li>{entry.data.status === 'planned' ? (lang === 'pt' ? 'Planejado' : 'Planned') : (lang === 'pt' ? 'Ativo' : 'Active')}</li>
      {entry.data.tags.map(tag => <li>{tag}</li>)}
    </ul>
    {entry.data.status === 'planned' ? (
      <p class="muted">{lang === 'pt'
        ? 'Este experimento ainda está em planejamento. A demonstração executável estará disponível quando o módulo for implementado.'
        : 'This experiment is planned. An interactive demo will be available when the module is implemented.'}</p>
    ) : entry.data.type === 'external-link' ? (
      <p><a href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">{lang === 'pt' ? 'Abrir projeto externo' : 'Open external project'}</a></p>
    ) : <AppRunner app={entry} lang={lang} />}
  </article>
</BaseLayout>
