---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, getPublishedArticles, type Article } from '../lib/content';
import { alternateLang, localePath, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; entry: Article }
const { lang, entry } = Astro.props;
const u = t(lang);
const { Content } = await render(entry);
const other = alternateLang(lang);
const counterpart = (await getPublishedArticles(other)).find(otherEntry =>
  entry.data.translationKey
    ? otherEntry.data.translationKey === entry.data.translationKey
    : entrySlug(otherEntry.id) === entrySlug(entry.id)
);
const switchUrl = counterpart ? localePath(other, `articles/${entrySlug(counterpart.id)}`) : localePath(other, 'articles');
const alternates = counterpart ? {
  [lang]: localePath(lang, `articles/${entrySlug(entry.id)}`),
  [other]: switchUrl,
} : { [lang]: localePath(lang, `articles/${entrySlug(entry.id)}`) };
---
<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} switchUrl={switchUrl} alternates={alternates}>
  <p><a href={localePath(lang, 'articles')}>← {u.back}</a></p>
  <article class="article-body">
    <header>
      <h1>{entry.data.title}</h1>
      <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US')}</time>
      <p class="lead">{entry.data.description}</p>
      <ul class="tags" aria-label="Tags">{entry.data.tags.map(tag => <li>{tag}</li>)}</ul>
    </header>
    <Content />
  </article>
</BaseLayout>
