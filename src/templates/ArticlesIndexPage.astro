---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticlesDiscovery from '../components/ArticlesDiscovery.astro';
import { getPublishedArticles } from '../lib/content';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const articles = await getPublishedArticles(lang);
---
<BaseLayout lang={lang} title={u.articlesTitle} description={u.articlesTitle}>
  <h1>{u.articlesTitle}</h1>
  {articles.length ? <ArticlesDiscovery lang={lang} articles={articles} /> : <p>{u.noArticles}</p>}
</BaseLayout>
