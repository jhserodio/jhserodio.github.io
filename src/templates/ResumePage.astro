---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBars from '../components/SkillBars.astro';
import { getResume, t } from '../i18n/utils';
import { mePt } from '../i18n/me/pt';
import { meEn } from '../i18n/me/en';
import type { Lang } from '../i18n/ui';
import '../styles/resume.css';
import { localePath } from '../i18n/utils';

interface Props { lang: Lang }

const { lang } = Astro.props;
const u = t(lang);
const resume = getResume(lang);
const me = lang === 'pt' ? mePt : meEn;
const projectCategoryLabels = {
  pt: { academic: 'Acadêmico', 'open-source': 'Código aberto', production: 'Produção' },
  en: { academic: 'Academic', 'open-source': 'Open source', production: 'Production' },
} as const;
const contacts = [
  { label: me.contact.email.label, value: me.contact.email.value, href: `mailto:${me.contact.email.value}`, external: false },
  { label: me.contact.numberPhone.label, value: me.contact.numberPhone.value, href: `tel:${me.contact.numberPhone.value.replace(/[^+\d]/g, '')}`, external: false },
  { label: me.contact.github.label, value: me.contact.github.value, href: me.contact.github.value, external: true },
  { label: me.contact.linkedin.label, value: me.contact.linkedin.value, href: me.contact.linkedin.value, external: true },
  { label: me.contact.leetcode.label, value: me.contact.leetcode.value, href: me.contact.leetcode.value, external: true },
];
const headerContacts = [
  { label: 'LinkedIn', href: me.contact.linkedin.value, external: true },
  { label: 'Email', href: `mailto:${me.contact.email.value}`, external: false },
  { label: 'GitHub', href: me.contact.github.value, external: true },
  { label: 'LeetCode', href: me.contact.leetcode.value, external: true },
];
---
<BaseLayout lang={lang} title={u.resumeTitle} description={resume.summary}>
  <article class="resume-page">
    <section class="resume-overview" aria-labelledby="resume-title">
      <div class="resume-overview-heading">
        <h1 id="resume-title">{u.resumeTitle}</h1>
        <nav class="resume-quick-links" aria-label={lang === 'pt' ? 'Contatos e perfis profissionais' : 'Contact and professional profiles'}>
          {headerContacts.map(({label, href, external}) => (
            <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer me' : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </div>
      <h2 class="resume-subheading">{me.about.title}</h2>
      <p class="lead resume-summary">{resume.summary}</p>
    </section>

    <div class="resume-intro-grid">
      <section class="resume-intro-panel" aria-labelledby="edu-heading">
        <h2 id="edu-heading" class="resume-panel-title">{u.education}</h2>
        <ul class="resume-education-list">
          {resume.education.map(edu => (
            <li class="resume-education-item">
              <h3>{edu.degree}</h3>
              <p class="resume-education-institution">{edu.institution}</p>
              <p class="muted resume-period">{edu.period.start} – {edu.period.end ?? (lang === 'pt' ? 'Atual' : 'Present')}</p>
            </li>
          ))}
        </ul>
      </section>
      <section class="resume-intro-panel" aria-labelledby="contacts-heading">
        <h2 id="contacts-heading" class="resume-panel-title">{me.contact.title}</h2>
        <ul class="resume-contact-list">
          {contacts.map(contact => (
            <li class="resume-contact-item">
              <span class="resume-contact-label">{contact.label}</span>
              <a href={contact.href} target={contact.external ? '_blank' : undefined} rel={contact.external ? 'noopener noreferrer' : undefined}>
                {contact.value}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <SkillBars lang={lang} />

    <section class="resume-work-section" aria-labelledby="exp-heading">
      <h2 id="exp-heading" class="resume-section-title">{u.experiences}</h2>
      <div class="resume-work-list">
        {resume.experiences.map(exp => (
          <article class="resume-work-item">
            <header class="resume-work-header">
              <div class="resume-work-identity">
                <h3>{exp.company}</h3>
                <p class="resume-work-role">{exp.role}</p>
              </div>
              <p class="resume-work-period">
                <span class="visually-hidden">{lang === 'pt' ? 'Período: ' : 'Period: '}</span>
                {exp.period.start} – {exp.period.end ?? (lang === 'pt' ? 'Atual' : 'Present')}
              </p>
            </header>
            <div class="resume-work-description">
              {exp.description.map(text => <p>{text}</p>)}
              {exp.achievements.length > 0 && (
                <ul class="resume-achievements">{exp.achievements.map(text => <li>{text}</li>)}</ul>
              )}
            </div>
            {exp.technologies.length > 0 && (
              <ul class="tags resume-work-technologies" aria-label={lang === 'pt' ? 'Tecnologias' : 'Technologies'}>
                {exp.technologies.map(tech => <li>{tech}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <div class="resume-extra-grid">
      <section class="resume-extra-panel" aria-labelledby="langs-heading">
        <h2 id="langs-heading" class="resume-panel-title">{lang === 'pt' ? 'Idiomas' : 'Languages'}</h2>
        <ul class="resume-language-list">
          {resume.languages.map(item => (
            <li><strong>{item.name}</strong><span>{item.level}</span></li>
          ))}
        </ul>
      </section>
      <section class="resume-extra-panel" aria-labelledby="soft-heading">
        <h2 id="soft-heading" class="resume-panel-title">{lang === 'pt' ? 'Competências interpessoais' : 'Soft skills'}</h2>
        <ul class="resume-soft-list">
          {resume.softSkills.map(skill => <li>{skill}</li>)}
        </ul>
      </section>
    </div>

    <section class="resume-projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="resume-section-title">{u.projects}</h2>
      <div class="card-grid resume-project-grid">
        {resume.projects.map(project => (
          <article class="card resume-project-card">
            <h3>{project.title}</h3>
            <small>{projectCategoryLabels[lang][project.category]}</small>
            <p>{project.description}</p>
            {project.highlights.length > 0 && (
              <ul class="resume-project-highlights">
                {project.highlights.map(highlight => <li>{highlight}</li>)}
              </ul>
            )}
            <ul class="tags" aria-label={lang === 'pt' ? 'Tecnologias' : 'Technologies'}>
              {project.technologies.map(tech => <li>{tech}</li>)}
            </ul>
            <div class="resume-project-links">
              {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
              {project.links.articleSlug && (
                <a href={localePath(lang, `articles/${project.links.articleSlug}`)}>
                  {lang === 'pt' ? 'Ler série Math with Rust' : 'Read Math with Rust series'}
                </a>
              )}
              {project.links.live && <a href={project.links.live} target="_blank" rel="noopener noreferrer">Live</a>}
            </div>
          </article>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
