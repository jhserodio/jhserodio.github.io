---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResume, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const resume = getResume(lang);
---
<BaseLayout lang={lang} title={u.resumeTitle} description={resume.summary}>
  <h1>{u.resumeTitle}</h1>
  <p class="lead">{resume.summary}</p>
  <section aria-labelledby="exp-heading">
    <h2 id="exp-heading">{u.experiences}</h2>
    {resume.experiences.map(exp => (
      <article class="stack resume-entry">
        <h3>{exp.role} — {exp.company}</h3>
        <p class="muted"><time>{exp.period.start}</time> – {exp.period.end ?? (lang === 'pt' ? 'Atual' : 'Present')}</p>
        {exp.description.map(text => <p>{text}</p>)}
        {exp.achievements.length > 0 && <ul>{exp.achievements.map(text => <li>{text}</li>)}</ul>}
        {exp.technologies.length > 0 && <ul class="tags" aria-label={lang === 'pt' ? 'Tecnologias' : 'Technologies'}>{exp.technologies.map(tech => <li>{tech}</li>)}</ul>}
      </article>
    ))}
  </section>
  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">{lang === 'pt' ? 'Competências técnicas' : 'Technical skills'}</h2>
    {resume.skills.map(group => (
      <div class="stack resume-skills">
        <h3>{group.title}</h3>
        <ul class="tags">{group.items.map(item => <li>{item}</li>)}</ul>
      </div>
    ))}
  </section>
  <section aria-labelledby="soft-heading">
    <h2 id="soft-heading">{lang === 'pt' ? 'Competências interpessoais' : 'Soft skills'}</h2>
    <ul>{resume.softSkills.map(skill => <li>{skill}</li>)}</ul>
  </section>
  <section aria-labelledby="langs-heading">
    <h2 id="langs-heading">{lang === 'pt' ? 'Idiomas' : 'Languages'}</h2>
    <ul>{resume.languages.map(item => <li><strong>{item.name}:</strong> {item.level}</li>)}</ul>
  </section>
  <section aria-labelledby="edu-heading">
    <h2 id="edu-heading">{u.education}</h2>
    {resume.education.map(edu => (
      <article class="resume-entry">
        <h3>{edu.degree} — {edu.institution}</h3>
        <p class="muted">{edu.period.start} – {edu.period.end ?? (lang === 'pt' ? 'Atual' : 'Present')}</p>
      </article>
    ))}
  </section>
  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">{u.projects}</h2>
    <div class="card-grid">
      {resume.projects.map(project => (
        <article class="card">
          <h3>{project.title}</h3>
          <small>{project.category}</small>
          <p>{project.description}</p>
          <ul class="tags">{project.technologies.map(tech => <li>{tech}</li>)}</ul>
          {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
          {project.links.live && <span> · <a href={project.links.live} target="_blank" rel="noopener noreferrer">Live</a></span>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
